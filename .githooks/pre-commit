#!/bin/sh
# ========================================================
# 🛡️ GITHUB GRIND: PRE-COMMIT SECRET SCANNER
# ========================================================
# Prevents accidental commits of API keys, private keys, or tokens.

# Patterns for high-risk secrets
PATTERNS='(AIza[0-9A-Za-z\\-_]{35}|sk-[a-zA-Z0-9]{32,}|sk-ant-[a-zA-Z0-9_]{32,}|ghp_[0-9a-zA-Z]{36}|github_pat_[0-9a-zA-Z_]{22,}|AKIA[0-9A-Z]{16}|sk_live_[0-9a-zA-Z]{24}|-----BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY-----)'

# Files to never commit
FORBIDDEN_FILES='(\.env$|\.env\.local|\.env\.production|id_rsa|service_account.*\.json|credentials\.json)'

# Check 1: Check staged file names
STAGED_FILES=$(git diff --cached --name-only)
for FILE in $STAGED_FILES; do
    if echo "$FILE" | grep -Eq "$FORBIDDEN_FILES"; then
        echo "\033[0;31m[BLOCKED] Attempting to commit forbidden secret file: $FILE\033[0m"
        echo "\033[0;33mPlease remove this file from staging: git reset HEAD $FILE\033[0m"
        exit 1
    fi
done

# Check 2: Check staged diff contents for secret patterns
DIFF=$(git diff --cached -U0)
MATCHES=$(echo "$DIFF" | grep -E "^\+" | grep -E "$PATTERNS")

if [ -n "$MATCHES" ]; then
    echo "\033[0;31m====================================================\033[0m"
    echo "\033[0;31m[SECURITY ALERT] Potential API Key or Secret Detected!\033[0m"
    echo "\033[0;31m====================================================\033[0m"
    echo "$MATCHES"
    echo ""
    echo "\033[0;33mCommit aborted. Please remove sensitive keys before committing.\033[0m"
    exit 1
fi

exit 0
